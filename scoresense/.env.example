# Supabase project credentials (Project Settings -> API in the Supabase dashboard).
# These are safe to expose to the browser: NEXT_PUBLIC_* vars are bundled into
# client code, and the publishable key is designed to be public — access is
# enforced by Row Level Security in Postgres, not by keeping this key secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service-role key (Project Settings -> API in the Supabase dashboard). Bypasses
# Row Level Security — required so the Stripe webhook handler (which has no
# user session) can write subscription/upload status on a user's behalf.
# Server-only: never reference it from client components, and never prefix it
# with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Stripe (Dashboard -> Developers -> API keys / Product catalog / Webhooks).
# Secret key: server-only, never expose to the client or prefix with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=

# Webhook signing secret for the /api/webhooks/stripe endpoint. Locally, get
# this from `stripe listen --forward-to localhost:3000/api/webhooks/stripe` —
# it prints a whsec_... value each time you run it. In production, create a
# webhook endpoint in the Stripe Dashboard pointing at
# https://<your-domain>/api/webhooks/stripe and use the signing secret shown
# there instead — it's a different value from the local CLI one.
STRIPE_WEBHOOK_SECRET=

# Price ID for the single ScoreSense subscription (Dashboard -> Product
# catalog -> your Product -> Pricing). Changing the amount later means
# creating a new Price in Stripe and swapping this ID — never hardcode
# amounts in code.
STRIPE_PRICE_ID=

# Sentry source-map upload token (Project Settings -> Auth Tokens in Sentry).
# Only needed for the sentry-cli build step; not read at runtime. Keep this in
# .env.sentry-build-plugin (gitignored) rather than committing it here — see
# that file's own header comment for details.
# SENTRY_AUTH_TOKEN=
